# Publish Grafana on loopback for a NAS-local HTTPS reverse proxy.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
# Set the public URL when using a reverse proxy, e.g. https://logs.example.invalid/
# GRAFANA_ROOT_URL=https://logs.example.invalid/

LOG_HOST=nas
LOG_ENVIRONMENT=production
LOG_RETENTION=720h
# Opt in the Dagsverk DSM package's exact Docker container name.
DAGSVERK_COLLECT_DSM_PACKAGE=false

# Used only by compose.syslog.yaml. Loopback is suitable for this NAS's DSM.
SYSLOG_BIND_ADDRESS=127.0.0.1
SYSLOG_PORT=1514
