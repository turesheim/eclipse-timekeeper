<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.resheim.eclipse.timekeeper</groupId>
    <artifactId>net.resheim.eclipse.timekeeper-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>net.resheim.eclipse.timekeeper.jira-test</artifactId>
  <packaging>eclipse-test-plugin</packaging>
  <properties>
    <jira.test.vmargs>-Xmx1024m -Dnet.resheim.eclipse.timekeeper.db.url=jdbc:h2:${project.build.directory}/acceptance-data/timekeeper -Dtimekeeper.jira.proof=${project.build.directory}/acceptance-data/restart.properties -Dtimekeeper.jira.report=${project.build.directory}/acceptance-data</jira.test.vmargs>
  </properties>
  <profiles>
    <profile>
      <id>macosx</id>
      <activation><os><family>mac</family></os></activation>
      <properties><jira.test.vmargs>-XstartOnFirstThread -Xmx1024m -Dnet.resheim.eclipse.timekeeper.db.url=jdbc:h2:${project.build.directory}/acceptance-data/timekeeper -Dtimekeeper.jira.proof=${project.build.directory}/acceptance-data/restart.properties -Dtimekeeper.jira.report=${project.build.directory}/acceptance-data</jira.test.vmargs></properties>
    </profile>
  </profiles>
  <build><plugins>
    <plugin>
      <groupId>org.eclipse.tycho</groupId><artifactId>target-platform-configuration</artifactId>
      <configuration><target>
        <artifact><groupId>net.resheim.eclipse.timekeeper</groupId><artifactId>net.resheim.eclipse.timekeeper-parent</artifactId><version>2.0.0-SNAPSHOT</version><classifier>default</classifier></artifact>
        <file>${project.basedir}/jira.target</file>
      </target>
        <dependency-resolution><extraRequirements>
          <requirement><type>eclipse-feature</type><id>net.resheim.eclipse.timekeeper</id><versionRange>0.0.0</versionRange></requirement>
          <requirement><type>eclipse-feature</type><id>net.resheim.eclipse.timekeeper.mylyn.feature</id><versionRange>0.0.0</versionRange></requirement>
          <requirement><type>eclipse-feature</type><id>me.glindholm.connector.eclipse.jira</id><versionRange>[6.0.0.202605160149,6.0.0.202605160150)</versionRange></requirement>
          <requirement><type>p2-installable-unit</type><id>org.eclipse.platform.ide</id><versionRange>0.0.0</versionRange></requirement>
          <requirement><type>eclipse-feature</type><id>org.eclipse.platform</id><versionRange>0.0.0</versionRange></requirement>
          <requirement><type>eclipse-plugin</type><id>slf4j.simple</id><versionRange>[2.0.18,2.0.19)</versionRange></requirement>
        </extraRequirements></dependency-resolution>
      </configuration>
    </plugin>
    <plugin>
      <groupId>org.eclipse.tycho</groupId><artifactId>tycho-surefire-plugin</artifactId><version>${tycho.version}</version>
      <configuration>
        <forkedProcessTimeoutInSeconds>240</forkedProcessTimeoutInSeconds>
        <failIfNoTests>true</failIfNoTests>
        <testRuntime>p2Installed</testRuntime>
        <install>
          <iu><id>org.eclipse.platform.ide</id></iu>
          <iu><id>slf4j.simple</id><version>2.0.18</version></iu>
          <iu><id>net.resheim.eclipse.timekeeper.feature.group</id></iu>
          <iu><id>net.resheim.eclipse.timekeeper.mylyn.feature.feature.group</id></iu>
          <iu><id>me.glindholm.connector.eclipse.jira.feature.group</id><version>6.0.0.202605160149</version></iu>
        </install>
        <argLine>${jira.test.vmargs}</argLine>
        <useUIHarness>true</useUIHarness><useUIThread>false</useUIThread>
        <product>org.eclipse.platform.ide</product><application>org.eclipse.ui.ide.workbench</application>
      </configuration>
      <executions>
        <execution><id>default-test</id><configuration><includes><include>**/JiraConnectorTest.java</include></includes></configuration></execution>
        <execution><id>restart-acceptance</id><phase>verify</phase><goals><goal>test</goal></goals>
          <configuration><includes><include>**/JiraRestartTest.java</include></includes><osgiDataDirectory>${project.build.directory}/work/restart/data</osgiDataDirectory><reportsDirectory>${project.build.directory}/surefire-reports-restart</reportsDirectory></configuration>
        </execution>
      </executions>
    </plugin>
  </plugins></build>
</project>
