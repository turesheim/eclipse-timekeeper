#!/bin/sh
set -eu
. /usr/syno/bin/jsoncmd
if ! diagnostic=$("$(dirname "$0")/../timekeeper-dsm" hyper-backup-export 2>&1); then
    case "$diagnostic" in
        "Cannot determine the package state; application data was not changed"|\
        "Cannot stop the package for application backup or restore"|\
        "The package could not restart after application backup or restore; inspect Package Center"|\
        "Another application backup or restore is running"|\
        "Application backup or restore failed; follow the native recovery instructions")
            jerr "$diagnostic"
            ;;
        *) jerr "Dagsverk application backup failed. Check the package and PostgreSQL status." ;;
    esac
    exit 1
fi
jout_begin
joutstr "app_data_version" "1.0"
jout_end
