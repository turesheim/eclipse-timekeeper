# Set an absolute NAS path before running setup.py.
COMPOSE_PROJECT_NAME=timekeeper
TIMEKEEPER_STATE_DIR=/volume1/docker/timekeeper/state
# Tailscale Serve forwards HTTPS to this loopback listener; see LOCAL.md.
TIMEKEEPER_BIND_ADDRESS=127.0.0.1
TIMEKEEPER_HTTP_PORT=8080
# edge tracks tested main builds. Pin sha-<commit> for a fixed deployment.
TIMEKEEPER_SERVER_IMAGE=ghcr.io/turesheim/eclipse-timekeeper-server:edge
# Database upgrades are separate maintenance operations.
TIMEKEEPER_POSTGRES_IMAGE=postgres:18.6-bookworm
