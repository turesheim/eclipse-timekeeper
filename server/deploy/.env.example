# Set an absolute NAS path before running setup.py.
COMPOSE_PROJECT_NAME=timekeeper
DAGSVERK_STATE_DIR=/volume1/docker/timekeeper/state
# Tailscale Serve forwards HTTPS to this loopback listener; see LOCAL.md.
DAGSVERK_BIND_ADDRESS=127.0.0.1
DAGSVERK_HTTP_PORT=8080
# edge tracks tested main builds. Pin sha-<commit> for a fixed deployment.
DAGSVERK_SERVER_IMAGE=ghcr.io/turesheim/eclipse-timekeeper-server:edge
# Database upgrades are separate maintenance operations.
DAGSVERK_POSTGRES_IMAGE=postgres:18.6-bookworm
# UTC time of the initial deployment; replace on manual deployments, keep on restarts.
# update.sh records a fresh timestamp for each rolling update automatically.
# DAGSVERK_DEPLOYED_AT=2026-10-13T08:30:00Z
# Exact browser origin when using Tailscale Serve or another HTTPS reverse proxy.
# DAGSVERK_PUBLIC_ORIGIN=https://timekeeper.example.ts.net
# Increase on ALL replicas when retiring a browser/recovery origin; see ACCOUNTS.md.
DAGSVERK_AUTH_ORIGIN_EPOCH=1
# Passkeys need a configured HTTPS DNS hostname. AUTO uses that hostname as the RP.
DAGSVERK_PASSKEYS_ENABLED=true
DAGSVERK_PASSKEY_RP_ID=AUTO
# Optional SMTP settings: state/config/mail.properties and state/secrets/timekeeper_smtp_password.
# setup.py sets this for a fresh installation. Existing deployments require explicit migration.
# DAGSVERK_SERVER_SETUP_FILE=/config/account-setup.json
# Opt in only after backing up and stopping BOTH older replicas; see ACCOUNTS.md.
# DAGSVERK_ALLOW_SCHEMA_UPGRADE=true

# Managed OAuth requires a deployed service; direct registration is configured in Administration.
DAGSVERK_CONNECT_SHARED=true
# DAGSVERK_CONNECT_SERVICE_URL=https://connect.example.test
